{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "MOBILE_API_BASE_URL": "https://taskflow-demo.duckdns.org",
        "MOBILE_REALTIME_BASE_URL": "https://taskflow-demo.duckdns.org",
        "MOBILE_COLLAB_BASE_URL": "https://taskflow-demo.duckdns.org"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "MOBILE_API_BASE_URL": "https://taskflow-demo.duckdns.org",
        "MOBILE_REALTIME_BASE_URL": "https://taskflow-demo.duckdns.org",
        "MOBILE_COLLAB_BASE_URL": "https://taskflow-demo.duckdns.org"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
