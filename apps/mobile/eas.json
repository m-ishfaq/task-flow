{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "MOBILE_API_BASE_URL": "http://localhost:3000"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "MOBILE_API_BASE_URL": "SET-MOBILE_API_BASE_URL-BEFORE-BUILDING-PRODUCTION"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
