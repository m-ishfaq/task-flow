# TaskFlow — local development environment
#
# Copy to .env and adjust. NEVER commit .env (see .gitignore).
# Every variable here is validated by the Zod env schema at boot (PLAN.md §8.7);
# a missing or malformed value fails startup rather than surfacing at runtime.

NODE_ENV=development
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (PLAN.md §8.3)
#
# The application connects as taskflow_app, which CANNOT bypass RLS.
# Migrations connect as taskflow_migrator. Keeping these separate is what makes
# guardrail 3 real — do not collapse them into one URL.
#
# Port 5433, not 5432 — see the note in compose.yaml. A natively installed
# Postgres (the pgAdmin installer bundles one) holds 5432 and silently answers
# instead of the container.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://taskflow_app:app-dev-secret@localhost:5433/taskflow
DATABASE_MIGRATION_URL=postgresql://taskflow_migrator:migrator-dev-secret@localhost:5433/taskflow
DATABASE_AUDIT_URL=postgresql://taskflow_audit:audit-dev-secret@localhost:5433/taskflow
# apps/realtime's own outbox consumer role (Phase 4 §3.5, migration 0016).
# A FOURTH role rather than reusing taskflow_audit — it holds nothing on
# audit.audit_log, and can mark an event dispatched only for consumer =
# 'realtime' (the migration's own WITH CHECK).
DATABASE_REALTIME_URL=postgresql://taskflow_realtime:realtime-dev-secret@localhost:5433/taskflow
# apps/collab's write-exception role (Phase 6 Wave 2 §6.1, migration 0024).
# INSERT/SELECT on docs.yjs_updates and docs.page_versions, DELETE on
# yjs_updates (compaction's pruning) — nothing else. apps/collab's
# onAuthenticate hook keeps reading docs.pages/docs.spaces over DATABASE_URL,
# same as Wave 1.
DATABASE_COLLAB_URL=postgresql://taskflow_collab:collab-dev-secret@localhost:5433/taskflow
# The backlinks relay's claim role (Phase 6 Wave 3 §3.10, migration 0025).
# COLUMN-LEVEL SELECT on docs.page_versions (id, org_id, page_id, created_at —
# never state) plus SELECT/INSERT on docs.backlink_dispatch, across every
# tenant — this role discovers which pages changed and can never read what
# changed. The actual content read happens over DATABASE_URL, per page.
DATABASE_BACKLINKS_URL=postgresql://taskflow_backlinks:backlinks-dev-secret@localhost:5433/taskflow
# The due-reminder sweep's claim role (Phase 9 Wave 2 §3.8, migration 0029).
# COLUMN-LEVEL SELECT on work.cards (id, org_id, board_id, title, number,
# due_date, assignee_ids — never description or rank) plus SELECT/INSERT on
# platform.notifications and notification_deliveries and SELECT on
# notification_prefs, across every tenant — this role finds which cards are
# due and can never read anything else about them.
DATABASE_NOTIFICATION_SWEEP_URL=postgresql://taskflow_notification_sweep:sweep-dev-secret@localhost:5433/taskflow

# The search indexer's outbox claim role (Phase 8 Wave 2 §2.3, migration 0045).
# SELECT on platform.outbox (for the claim) and SELECT/INSERT/UPDATE on
# outbox_dispatch scoped to consumer = 'search' — across every tenant, like
# every consumer role. It holds NOTHING on search.documents: the actual
# indexing happens per event over DATABASE_URL, under withOrgScope.
DATABASE_SEARCH_URL=postgresql://taskflow_search:search-dev-secret@localhost:5433/taskflow

# The automation engine's outbox claim role (Phase 10 Wave 1, migration 0047).
# Read by apps/worker, never by the API. Same claim-only shape as the search
# role above and narrower in what it protects: it holds NOTHING on
# platform.automations, automation_runs or automation_budget, so the role that
# decides which events might fire a rule cannot read a rule, record a run, or
# perform an action. All of that happens per event over DATABASE_URL, under
# withOrgScope and through apps/api's own service layer.
DATABASE_AUTOMATION_URL=postgresql://taskflow_automation:automation-dev-secret@localhost:5433/taskflow
# The webhook delivery loop's claim role (Phase 10 Wave 2, migration 0049).
# Read by apps/worker, never by the API. It can CLAIM due deliveries and record
# their outcomes across every tenant — and nothing else: no grant on
# platform.webhooks, and its SELECT on webhook_deliveries is column-level and
# excludes payload. The endpoint URL, the signing secret and the payload are
# all read per org over DATABASE_URL, under withOrgScope.
DATABASE_WEBHOOK_URL=postgresql://taskflow_webhook:webhook-dev-secret@localhost:5433/taskflow
# The platform-admin console's connection (Phase 12 Wave 1 §3.7, migration
# 0035). taskflow_platform_admin reads identity.orgs and identity.memberships
# across EVERY tenant (the org directory) and writes orgs.status; it holds
# nothing on any product table. Same optionality as every consumer role: an
# instance that never serves a console request does not need it, and
# withPlatformAdminScope throws rather than silently falling back to the
# application role.
DATABASE_PLATFORM_ADMIN_URL=postgresql://taskflow_platform_admin:platform-admin-dev-secret@localhost:5433/taskflow
DATABASE_POOL_MAX=10

# Target for `migrate:verify` ONLY, and deliberately a separate variable.
#
# That command reverts every migration before re-applying them, so it drops
# every table and everything in them. Sharing DATABASE_MIGRATION_URL meant the
# command you run to check your migrations are reversible deleted the org,
# boards and cards you were developing against — and printed `verify: OK`,
# because from its point of view it worked.
#
# Leave it unset: the default is taskflow_test, created by 04-test-database.sql.
# The runner refuses any database whose name does not end in `_test`.
# DATABASE_VERIFY_URL=postgresql://taskflow_migrator:migrator-dev-secret@localhost:5433/taskflow_test

# ---------------------------------------------------------------------------
# Object storage — MinIO locally, Cloudflare R2 in deployed environments (§5)
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=taskflow
STORAGE_SECRET_ACCESS_KEY=taskflow-dev-secret
STORAGE_BUCKET_ATTACHMENTS=taskflow-attachments
STORAGE_BUCKET_EXPORTS=taskflow-exports
STORAGE_FORCE_PATH_STYLE=true
# Largest attachment accepted. Pinned into the upload signature and used as the
# ceiling on the server-side read during scanning, so it bounds memory too.
STORAGE_MAX_UPLOAD_BYTES=26214400

# Virus scanning (PLAN.md 8.4). An attachment is not downloadable until clamd
# has looked at it, and an unreachable scanner fails CLOSED.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ---------------------------------------------------------------------------
# Mail — Mailpit locally (UI at http://localhost:8025), Resend in production
# ---------------------------------------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_FROM="TaskFlow <no-reply@taskflow.local>"

# ---------------------------------------------------------------------------
# Web Push VAPID keys (Phase 9 Wave 2 §3.7, migration 0029)
#
# Optional: with these unset the app runs fine and the preferences page says
# push is unavailable on the server, honestly. Generate a fresh pair with:
#   node -e "import('@taskflow/security').then(s => console.log(JSON.stringify(s.generateVapidKeys(), null, 2)))"
# VAPID_SUBJECT is the contact the push service shows — a mailto: URL.
# ---------------------------------------------------------------------------
VAPID_SUBJECT=mailto:no-reply@taskflow.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# OAuth sign-in (Phase 12 Wave 2 §3.3, migration 0033)
#
# Optional, and independently so per provider: with a provider's client id/
# secret unset, its sign-in button simply does not render.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Cryptography (PLAN.md §8.4)
#
# SoftwareKeyProvider master key. Generate a fresh one — never reuse this value,
# and never use a dev key in a deployed environment:
#   node -e "import('@taskflow/security').then(s => console.log(s.generateMasterKeyBase64()))"
#
# MASTER_KEY_ID is stored alongside every wrapped data key so rotation can tell
# generations apart. Rotating means adding a NEW id and keeping the old key
# loaded — a retired key that is dropped makes everything it wrapped unreadable.
#
# In production this comes from the secrets manager, and the KmsKeyProvider
# replaces the software implementation entirely.
# ---------------------------------------------------------------------------
MASTER_KEY_ID=mk-dev-1
MASTER_KEY_BASE64=CHANGE_ME_generate_a_32_byte_key

# Signing key for access tokens. Same rule: generate your own.
JWT_SECRET=CHANGE_ME_generate_a_32_byte_key

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
API_PORT=3000
API_HOST=0.0.0.0
# The browser origin the WebSocket gateways (apps/realtime, apps/collab) accept
# at the handshake. To test from a phone through an ngrok tunnel, point this at
# the tunnel URL and browse to THAT URL from the desktop too — the value must
# stay a SINGLE URL (the API rejects a comma list here; it never checks Origin
# anyway, using the value only for WebAuthn's relying-party id and email
# links). A free ngrok static domain (<name>.ngrok-free.app) keeps this stable
# between sessions; with a throwaway URL, flip this per session. The tunnel
# host is already allowed through apps/web's vite.config.ts allowedHosts.
WEB_ORIGIN=http://localhost:5173

# Hosts the Vite dev server accepts besides localhost (tunnels such as ngrok),
# comma-separated, leading dot = any subdomain. Read by apps/web's
# vite.config.ts (`server.allowedHosts`), which loads this repo-root .env the
# same way the server apps do; listed in each server's known-vars set so this
# value does not trip their misspelling checks. Empty = strict localhost-only.
# ngrok's TLDs have shifted before (.app -> .dev), so extend the list as needed.
WEB_ALLOWED_HOSTS=.ngrok-free.app,.ngrok-free.dev,.ngrok.app,.ngrok.io

# How far to believe X-Forwarded-For.
#
#   false           no proxy — the client address is the socket address
#   <n>             trust exactly n hops, counted from the right
#   <cidr>,<cidr>   trust these proxy addresses
#
# `true` is REJECTED at boot. It means the client address is whatever a caller
# puts in the header, which makes every per-IP rate limit opt-out and records an
# attacker-chosen origin in the audit log. Behind one load balancer, set 1.
API_TRUST_PROXY=false

# Whether THIS instance runs the chat retention sweep (Phase 5 Wave 4 §3.7).
#
# Off by default, and the default is the safe one: the sweep has no SKIP-LOCKED
# claim, so two instances ticking together both issue the same DELETE — the
# second removes nothing but still emits a batch of `message.deleted` events,
# putting duplicate deletions in the compliance record. Exactly one instance
# should enable it. Parsed as the literal string 'true', never coerced, because
# `z.coerce.boolean()` treats every non-empty string as true — which would make
# `RETENTION_SWEEP_ENABLED=false` ENABLE a sweep that deletes user data.
RETENTION_SWEEP_ENABLED=false

# ---------------------------------------------------------------------------
# Realtime gateway — apps/realtime (ai/phase-4-realtime.md)
#
# Its own process, its own port, sharing JWT_SECRET and WEB_ORIGIN with the API
# because a socket connection is verified against the identical access token
# and the identical origin allow-list — see apps/realtime/src/config/env.ts.
# ---------------------------------------------------------------------------
REALTIME_PORT=3001
REALTIME_HOST=0.0.0.0
# Same shape and same reasoning as API_TRUST_PROXY above.
REALTIME_TRUST_PROXY=false

# How long before an access token expires the client proactively disconnects
# and reconnects with a fresh one (§7.1), rather than waiting for the gateway
# to refuse a stale token. Floor 30s (a slow refresh must finish first);
# ceiling strictly below the access token's own TTL, or every token is always
# "about to expire" and the client reconnects in a loop — both bounds enforced
# at boot, not just documented here.
REALTIME_REAUTH_LEAD_SECONDS=60

# The relay's poll interval — the correctness FLOOR, not the delivery
# mechanism. LISTEN/NOTIFY (migration 0016) makes the common case fast; this
# is what bounds a missed notification to latency rather than a lost event.
REALTIME_POLL_INTERVAL_MS=5000

# Rate limits (§6.5, §7.5) — their own numbers, not the login middleware's.
# Legitimate traffic here is one connection per tab and a handful of joins,
# which looks nothing like login abuse or a room-enumeration loop.
REALTIME_MAX_CONNECTIONS_PER_IP_PER_MINUTE=30
REALTIME_MAX_JOINS_PER_MINUTE=60
REALTIME_MAX_REFUSED_JOINS_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Collab gateway — apps/collab (ai/phase-6-docs.md)
#
# The Hocuspocus process, on its own port, sharing JWT_SECRET and WEB_ORIGIN
# with the API for the same reason apps/realtime does — its onAuthenticate hook
# verifies the identical access token. Both default (3002 / 0.0.0.0), so an
# instance that never overrides them does not need these lines; they are here
# because this file is what every process's misspelling check is kept in sync
# with, and a variable missing from it is a variable nobody knows to list.
# ---------------------------------------------------------------------------
COLLAB_PORT=3002
COLLAB_HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Worker — background jobs (ai/phase-10-automation.md §9 decision 1)
#
# The process that runs NEW background work: the automation engine, webhook
# delivery, and later the analytics rollup refresh. The seven loops already
# running inside the API stay there — this takes only what Phase 10 onward
# adds, because rule evaluation and outbound HTTP with retries must not share
# the thread that serves requests.
#
# The port carries health probes and nothing else. Both variables default
# (3003 / 2000ms), so an instance that never overrides them does not need these
# lines; they are here because this file is what every process's misspelling
# check is kept in sync with, and a variable missing from it is a variable
# nobody knows to list.
# ---------------------------------------------------------------------------
WORKER_PORT=3003
WORKER_POLL_INTERVAL_MS=2000

# ---------------------------------------------------------------------------
# Telephony — Voice & Messaging (ai/phase-7-voice.md; PLAN.md §8.5)
#
# ALL OPTIONAL — and that is deliberate. An API instance serving Work, Chat and
# Docs with no carrier credentials is a valid deployment, and a developer must
# not need a Twilio account to run this app. With them unset, buildTelephonyDeps
# returns undefined and every telephony route answers SERVICE_UNAVAILABLE
# rather than being registered-and-broken — the fail-closed direction.
#
# The values below are MOCK placeholders, never real credentials (§6.4,
# security-checklist.md) — Wave 1 is built and tested entirely against Twilio's
# free TEST credentials, which is why PLAN.md §14 budgets the whole phase at
# about two dollars a month. Each variable's comment says where the real value
# comes from; leave an optional one commented out until you need that surface.
# ---------------------------------------------------------------------------
# Twilio account — sign up free at twilio.com, then the Console dashboard
# (console.twilio.com) shows your Account SID and Auth Token. MOCK value below:
# the all-zero SID (and the ACtest prefix) is the codebase's own test-mode
# marker — deps.ts routes it to the IN-MEMORY FakeTelephonyProvider, so a copy
# of this file boots a fully working offline demo (number search/purchase,
# calls, SMS, spend) with no Twilio account and no way to spend real money.
# Paste a REAL AC... SID to switch to the live Twilio provider.
# TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Console → Verify → Services → create a service → its VA... SID. Only the
# Wave 4 Verify capability uses this, and it has no UI caller yet.
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# REQUIRED the moment TWILIO_ACCOUNT_SID is set — deps.ts refuses at boot
# otherwise. The blind-index key for counterparty phone numbers, separate from
# MASTER_KEY_BASE64 on purpose (one compromise must not both decrypt the column
# and let an attacker confirm guesses against it). Generate 32 random bytes,
# base64:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# TELEPHONY_INDEX_KEY=CHANGE_ME_base64_of_32_random_bytes

# The per-org spend cap in CENTS, over a rolling 30 days (§7.2). 2500 is roughly
# 12x the monthly spend this phase actually expects — high enough that a
# real demo never trips it, low enough that an SMS-pumping burst hits the wall in
# minutes. An explicit comms.spend_policy row for an org always wins over this,
# so changing it never silently re-caps an org someone has already decided about.
TELEPHONY_DEFAULT_SPEND_CAP_CENTS=2500

# The ceiling no self-service cap raise may exceed. This is why 'an Owner can
# raise the cap' is not the same as 'an Owner credential is unlimited spend': a
# compromised Owner account is a realistic route to toll fraud precisely BECAUSE
# raising the cap is a legitimate Owner action, and this is the one bound a
# stolen credential cannot move.
TELEPHONY_MAX_SPEND_CAP_CENTS=50000

# The absolute origin the carrier reaches this API on, used to rebuild the exact
# URL it signed. NEVER derived from the incoming request: the signature covers
# the URL, so deriving it from a request would let an attacker who controls the
# Host header control what we verify against. Only inbound SMS and call-status
# webhooks need this — point it at your tunnel, e.g. https://<name>.ngrok-free.app
# TELEPHONY_WEBHOOK_ORIGIN=https://api.example.com

# Where call recordings land. Create the bucket in the MinIO console
# (localhost:9001) or add it to compose.yaml's minio-init step — without it
# calls still place, recordings are simply not stored.
# STORAGE_BUCKET_RECORDINGS=taskflow-recordings

# The recording-ingest sweep's role (migration 0033): fetches recordings Twilio
# has finished processing. Same optionality as every other consumer role.
# DATABASE_RECORDING_INGEST_URL=postgresql://taskflow_recording_ingest:recording-dev-secret@localhost:5433/taskflow
# Exactly ONE instance runs the sweep — see the env schema's own note on
# RECORDING_INGEST_ENABLED for why the default is off.
# RECORDING_INGEST_ENABLED=true

# ---------------------------------------------------------------------------
# In-app voice — WebRTC (Phase 13 Wave 1, ai/phase-13-webrtc.md §3.3-§3.4)
#
# STUN and TURN are two variables, not one list, because they are governed
# differently: a STUN server learns your public address and relays nothing, so
# it costs nothing and needs no credential. A TURN server relays every byte of
# every call through it, on this deployment's bandwidth bill — which is why
# there is a gate in front of it at all (§3.4).
# ---------------------------------------------------------------------------
RTC_STUN_URLS=stun:localhost:3478

# TURN is OPTIONAL, and its absence is a valid deployment: STUN alone connects
# on most networks. What it must never be is half-configured — a URL with no
# secret hands the browser a relay it cannot authenticate against, and ICE
# falls back to STUN silently. The env schema refuses to boot on either half.
RTC_TURN_URLS=turn:localhost:3478?transport=udp
# coturn's `static-auth-secret`, matching compose.yaml's coturn service. It is
# never sent to a browser: the server mints a short-lived
# `<expiry>:<session-id>` / HMAC-SHA1 pair per call (packages/security's
# mintTurnCredential).
RTC_TURN_SECRET=coturn-dev-secret

# How long a minted credential lives. Long enough to cover ICE gathering and a
# renegotiation, short enough that a pair leaked into a log is worthless by the
# time anyone reads it.
RTC_TURN_TTL_SECONDS=600

# The DURABLE issuance budget per org over a rolling 24 hours. The TURN analogue
# of TELEPHONY_DEFAULT_SPEND_CAP_CENTS: counted in Postgres (rtc.turn_issuance),
# not in process, because an in-memory counter forgives everyone on restart.
RTC_TURN_ISSUANCE_CAP_PER_DAY=500

# `all` or `relay`. `relay` forces every candidate through TURN — not the
# production setting, but the only way to exercise the relay path deliberately.
# STUN works on most developer networks, so without this the TURN path stays
# untested until someone is behind a symmetric NAT, in production.
RTC_ICE_TRANSPORT_POLICY=all

# Signalling messages per socket per minute, on the gateway (§3.2). Far above
# the join limit on purpose: ICE trickling legitimately emits dozens of
# candidates per peer in the first seconds of a call. What it bounds is a peer
# using an authorized call room as a high-rate channel into another
# participant's browser.
REALTIME_MAX_SIGNALS_PER_MINUTE=600

# Ceiling on one uploaded call recording, PINNED into the presigned PUT's
# signature rather than merely checked — which is what makes it a limit instead
# of advice. At roughly 32 kbit/s for Opus in a WebM container, 64 MB is about
# four hours. Recording also needs STORAGE_BUCKET_RECORDINGS above; without it
# the recording routes answer SERVICE_UNAVAILABLE and calls work normally.
RTC_MAX_RECORDING_BYTES=67108864
