# TaskFlow — local development environment
#
# Copy to .env and adjust. NEVER commit .env (see .gitignore).
# Every variable here is validated by the Zod env schema at boot (PLAN.md §8.7);
# a missing or malformed value fails startup rather than surfacing at runtime.

NODE_ENV=development
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (PLAN.md §8.3)
#
# The application connects as taskflow_app, which CANNOT bypass RLS.
# Migrations connect as taskflow_migrator. Keeping these separate is what makes
# guardrail 3 real — do not collapse them into one URL.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://taskflow_app:app-dev-secret@localhost:5432/taskflow
DATABASE_MIGRATION_URL=postgresql://taskflow_migrator:migrator-dev-secret@localhost:5432/taskflow
DATABASE_AUDIT_URL=postgresql://taskflow_audit:audit-dev-secret@localhost:5432/taskflow
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Object storage — MinIO locally, Cloudflare R2 in deployed environments (§5)
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=taskflow
STORAGE_SECRET_ACCESS_KEY=taskflow-dev-secret
STORAGE_BUCKET_ATTACHMENTS=taskflow-attachments
STORAGE_BUCKET_EXPORTS=taskflow-exports
STORAGE_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Mail — Mailpit locally (UI at http://localhost:8025), Resend in production
# ---------------------------------------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_FROM="TaskFlow <no-reply@taskflow.local>"

# ---------------------------------------------------------------------------
# Cryptography (PLAN.md §8.4)
#
# SoftwareKeyProvider master key. Generate a fresh one — never reuse this value,
# and never use a dev key in a deployed environment:
#   node -e "import('@taskflow/security').then(s => console.log(s.generateMasterKeyBase64()))"
#
# MASTER_KEY_ID is stored alongside every wrapped data key so rotation can tell
# generations apart. Rotating means adding a NEW id and keeping the old key
# loaded — a retired key that is dropped makes everything it wrapped unreadable.
#
# In production this comes from the secrets manager, and the KmsKeyProvider
# replaces the software implementation entirely.
# ---------------------------------------------------------------------------
MASTER_KEY_ID=mk-dev-1
MASTER_KEY_BASE64=CHANGE_ME_generate_a_32_byte_key

# Signing key for access tokens. Same rule: generate your own.
JWT_SECRET=CHANGE_ME_generate_a_32_byte_key

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
API_PORT=3000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173

# How far to believe X-Forwarded-For.
#
#   false           no proxy — the client address is the socket address
#   <n>             trust exactly n hops, counted from the right
#   <cidr>,<cidr>   trust these proxy addresses
#
# `true` is REJECTED at boot. It means the client address is whatever a caller
# puts in the header, which makes every per-IP rate limit opt-out and records an
# attacker-chosen origin in the audit log. Behind one load balancer, set 1.
API_TRUST_PROXY=false
