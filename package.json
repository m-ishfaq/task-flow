{
  "name": "taskflow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "turbo run lint typecheck test",
    "seed": "pnpm --filter @taskflow/seed seed",
    "verify:guardrails": "node packages/guardrail-selftest/verify.js && node scripts/check-migration-rls.mjs && node scripts/verify-semgrep-rules.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:encoding:fix": "node scripts/check-encoding.mjs --fix",
    "preflight": "node scripts/preflight.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@taskflow/config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.6.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core",
      "argon2",
      "sharp"
    ],
    "overrides": {
      "brace-expansion@1": ">=1.1.18 <2",
      "brace-expansion@5": ">=5.0.9",
      "esbuild@<0.25.0": ">=0.25.0",
      "fast-uri@3": ">=3.1.5 <4",
      "fast-uri@4": ">=4.1.2",
      "js-yaml@4": ">=4.3.1",
      "nanoid@<3.3.17": ">=3.3.17",
      "vite@<6.4.3": ">=6.4.3",
      "ip-address": ">=10.3.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mh99-v99m-4gvg"
      ]
    }
  }
}
