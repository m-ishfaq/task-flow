# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# test + coverage
coverage/
playwright-report/
test-results/
.vitest/

# env + secrets  (never commit — see PLAN.md §8.8)
.env
.env.*
!.env.example
!.env.prod.example
*.pem
*.key
!*.pub.key
secrets.enc.yaml.dec

# local infra state
*.tfstate
*.tfstate.*
.terraform/
!.terraform.lock.hcl
docker/data/

# scanner caches (CI restores these from actions/cache)
.trivycache/

# editors / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# Expo / React Native (apps/mobile) — generated native projects and CLI state.
# Managed workflow (ai/phase-14-mobile.md §12 decision 5): these are build
# output, not source, and regenerating them from app.config.ts is exactly
# `expo prebuild`'s job. Keeping them out is what keeps this repo's checkout
# light — see the mobile-app planning thread on repo weight.
apps/mobile/.expo/
apps/mobile/ios/
apps/mobile/android/
apps/mobile/dist/
apps/mobile/web-build/
apps/mobile/.kotlin/
