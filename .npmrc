# Supply-chain posture (PLAN.md §8.8)
# Install scripts run ONLY for packages listed in package.json > pnpm.onlyBuiltDependencies.
# Everything else has its lifecycle scripts ignored.

# Pin the registry to HTTPS explicitly.
#
# This machine's global npm config resolved to http://registry.npmjs.org, which
# downloads every package over plaintext and makes package substitution possible
# for anyone on the network path. Setting it per-project means the repository
# does not inherit a misconfigured global.
registry=https://registry.npmjs.org/

# Reproducible installs — CI must never silently resolve a different tree.
prefer-frozen-lockfile=true

# Fail loudly on peer mismatches rather than resolving something unexpected.
auto-install-peers=true
strict-peer-dependencies=false

# Keep the store deterministic.
resolution-mode=highest

# TODO(node22): flip to true once the local runtime is upgraded from Node 20 (EOL).
engine-strict=false
