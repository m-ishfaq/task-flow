{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "TaskFlow React (apps/web)",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["${configDir}/src/**/*"]
}
