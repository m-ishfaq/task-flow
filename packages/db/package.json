{
  "name": "@taskflow/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrate": "./src/migrate/runner.ts"
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:up": "tsx src/migrate/cli.ts up",
    "migrate:down": "tsx src/migrate/cli.ts down",
    "migrate:status": "tsx src/migrate/cli.ts status",
    "migrate:verify": "tsx src/migrate/cli.ts verify"
  },
  "dependencies": {
    "@taskflow/observability": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@taskflow/config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
